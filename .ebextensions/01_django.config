option_settings:
  aws:elasticbeanstalk:application:environment:
    DJANGO_SETTINGS_MODULE: "recommendation_sys.settings"
    PYTHONPATH: "/var/app/current:$PYTHONPATH"
  aws:elasticbeanstalk:container:python:
    WSGIPath: "recommendation_sys.wsgi:application"

container_commands:
  01_create_db:
    command: "source /var/app/venv/*/bin/activate && cd /var/app/staging && python create_db_standalone.py 2>&1 || echo 'Database creation command completed (may have failed)'"
    leader_only: true
    ignoreErrors: true
  02_migrate:
    command: "source /var/app/venv/*/bin/activate && cd /var/app/staging && python manage.py migrate --noinput"
    leader_only: true
  03_collectstatic:
    command: "source /var/app/venv/*/bin/activate && cd /var/app/staging && python manage.py collectstatic --noinput --clear"
    leader_only: true
  04_createsu:
    command: "source /var/app/venv/*/bin/activate && cd /var/app/staging && python manage.py createsu"
    leader_only: true
    ignoreErrors: true
