###############################################################################
# HTTPS/SSL Configuration for AWS Elastic Beanstalk
# 
# This configuration:
# 1. Enables HTTPS (port 443) on the Application Load Balancer
# 2. Redirects all HTTP traffic to HTTPS
# 3. Configures security headers
#
# PREREQUISITES:
# - You must have an SSL certificate in AWS Certificate Manager (ACM)
# - Replace YOUR_CERTIFICATE_ARN with your actual certificate ARN
# - Format: arn:aws:acm:REGION:ACCOUNT_ID:certificate/CERTIFICATE_ID
###############################################################################

option_settings:
  # Enable HTTPS listener on the load balancer
  aws:elbv2:listener:443:
    ListenerEnabled: 'true'
    Protocol: HTTPS
    SSLCertificateArns: YOUR_CERTIFICATE_ARN
    SSLPolicy: ELBSecurityPolicy-TLS13-1-2-2021-06
    
  # Configure default process (your application)
  aws:elasticbeanstalk:environment:process:default:
    HealthCheckPath: /
    Port: '80'
    Protocol: HTTP

  # Environment properties for Django
  aws:elasticbeanstalk:application:environment:
    SECURE_SSL_REDIRECT: 'True'
    USE_HTTPS: 'True'

Resources:
  # HTTP to HTTPS redirect rule
  AWSEBV2LoadBalancerListener:
    Type: AWS::ElasticLoadBalancingV2::Listener
    Properties:
      LoadBalancerArn:
        Ref: AWSEBV2LoadBalancer
      Port: 80
      Protocol: HTTP
      DefaultActions:
        - Type: redirect
          RedirectConfig:
            Protocol: HTTPS
            Port: '443'
            Host: '#{host}'
            Path: '/#{path}'
            Query: '#{query}'
            StatusCode: HTTP_301




